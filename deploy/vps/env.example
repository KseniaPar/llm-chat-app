# Скопируйте: bash deploy/vps/setup-env.sh
# Файл deploy/vps/.env не коммитится в git.

SPRING_PROFILES_ACTIVE=vps

# Секреты — генерируются setup-env.sh; не публикуйте .env
JWT_SECRET=change-me-use-openssl-rand-base64-32
LOCAL_LLM_API_KEY=change-me-private-llm-key

# Ollama (7b — быстрее на CPU; нужно ~8 GB RAM на VPS)
LOCAL_LLM_MODEL=qwen2.5:7b
RAG_EMBED_MODEL=nomic-embed-text

# Демо-пользователь агента — выключен на продакшене
PLATFORM_DEMO_ENABLED=false
PLATFORM_DEMO_USER=student
PLATFORM_DEMO_PASSWORD=student

# Полностью локальный режим
LLM_PROVIDER=local

# nginx: IP или домен (для Let's Encrypt укажите домен)
NGINX_SERVER_NAME=_

# Ключ вшивается во frontend при сборке (= LOCAL_LLM_API_KEY)
VITE_LOCAL_LLM_API_KEY=change-me-private-llm-key
